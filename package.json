{
  "name": "fresh-scope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fresh-scope-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fresh-scope-db --remote"
  },
  "devDependencies": {
    "vite": "^7.3.6",
    "wrangler": "^4.125.0"
  }
}
