{
  "name": "fresh-scope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy ../dist --cwd pages --project-name fresh-scope",
    "sync:fuel": "node scripts/collect-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply fresh-scope-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fresh-scope-db --remote"
  },
  "devDependencies": {
    "vite": "^7.3.6",
    "wrangler": "^4.125.0"
  }
}
